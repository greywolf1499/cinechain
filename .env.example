# CineChain configuration. Copy to `.env` (docker compose and local dev both read it).
# Every value below can also be changed at runtime in Settings; admin-saved settings
# override the matching variables here.

# --- Identity / permissions (Docker) ---
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- App ---
# Host port to publish; container always listens on 8787 internally.
CINECHAIN_PORT=8787

# --- Security & storage ---
# Where the SQLite DB, secret key and downloaded models live (the Docker volume is /config).
# Outside Docker, point this at a writable folder, e.g. ./config
CONFIG_DIR=/config
# Optional explicit session-signing key. Leave blank to auto-generate and persist
# one at $CONFIG_DIR/secret.key (recommended). Set it to share one key across replicas.
SECRET_KEY=
# Set to true when CineChain is served over HTTPS (e.g. behind a reverse proxy) so
# session cookies get the `Secure` flag. Keep false for plain-http LAN access.
COOKIE_SECURE=false

# --- TMDB (required for browsing/searching new films) ---
# Free API key / read-access token: https://www.themoviedb.org/settings/api
# CineChain still boots without it and serves whatever is already cached.
TMDB_API_KEY=

# --- Optional ratings ---
OMDB_API_KEY=
# Optional daily soft cap; 0 lets the API's backpressure determine the limit.
OMDB_SOFT_CAP=0

# --- Optional homelab integrations ---
JELLYFIN_URL=
JELLYFIN_API_KEY=
RADARR_URL=
RADARR_API_KEY=
SEERR_URL=
SEERR_API_KEY=

# --- AI: embeddings (Semantic Trope Web, Aesthetic Gradient) ---
# local_onnx = zero-daemon, runs in-process (default) | ollama | openai (any OpenAI-compatible API)
EMBEDDING_PROVIDER=local_onnx
# Needed for ollama (e.g. http://ollama:11434) or openai-compatible servers; unused for local_onnx.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Remote model name (e.g. nomic-embed-text, text-embedding-3-small); unused for local_onnx.
EMBEDDING_MODEL=
# On-device model for local_onnx: arctic-embed-xs | multilingual-e5-small | all-minilm-l6-v2
# (alias of EMBEDDING_LOCAL_PRESET)
ONNX_MODEL_PRESET=arctic-embed-xs

# --- AI: generative LLM for pitches/teasers (opt-in, off by default) ---
# off | local_gguf (in-process Qwen 0.8B; download it with one click in Settings) | ollama | openai
LLM_PROVIDER=off
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# local_gguf only: seconds idle before the model is unloaded from RAM
# (0 = unload right after each call). Alias of LLM_KEEP_ALIVE_SECONDS.
LLM_IDLE_TIMEOUT_SECONDS=300

# --- Bridge solver tuning ---
# Wall-clock ceiling for one Bridge search (5-600).
BRIDGE_MAX_DURATION_SECONDS=45
PATHFINDER_MAX_DEPTH=5
PATHFINDER_CAST_LIMIT=15
PATHFINDER_ACTOR_CREDIT_LIMIT=120
