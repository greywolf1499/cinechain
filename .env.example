# --- Identity / permissions ---
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- Secrets ---
# Get a free API key/read-access token at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Optional homelab integrations ---
JELLYFIN_URL=
JELLYFIN_API_KEY=
RADARR_URL=
RADARR_API_KEY=
SEERR_URL=
SEERR_API_KEY=

# --- App ---
# Host port to publish; container always listens on 8787 internally.
CINECHAIN_PORT=8787
